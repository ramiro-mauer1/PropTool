# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (incl. backups like .env.bak-*, .env.local.bak-*)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local state
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# onnx models: the small ones ship with the app; LaMa (~208 MB) is over
# GitHub's 100 MB per-file limit and stays out (see src/lib/aiModels.ts).
public/models/*.onnx
!public/models/realesr-general-x4v3.onnx
!public/models/text_det.onnx


# local data samples & tooling
# Owners' names and phones: real listing data and screenshots never go to git.
plinth_muestra_captaciones.json
captaciones_*.json
capturas-captaciones/
/.claude/
/.impeccable/
